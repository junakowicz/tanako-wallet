# The app talks to the fee service at /api on its own domain by default.
# Set this only to point the app at a fee service hosted elsewhere.
# VITE_RELAYER_URL=https://example.com/api

# Fee service, local development (npm run relayer):
# RELAYER_PRIVATE_KEY=0x...   key of the service wallet, which holds a little POL
# RELAYER_PORT=8787
# PAYOUT_ADDRESS=0x...        where earnings above 5 USDC are forwarded (optional)
# When deployed, the key lives in Firebase as the secret RELAYER_PRIVATE_KEY,
# and PAYOUT_ADDRESS goes in functions/.env
